# Copy to .env. Generate random values; do not commit the populated file.
APP_USERNAME=demo
APP_PASSWORD=replace-with-a-long-unique-demo-password
SESSION_SECRET=replace-with-at-least-32-random-characters
MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Local development hosts
HOST=127.0.0.1
API_PORT=8000
MCP_HOST=127.0.0.1
MCP_PORT=8001
COOKIE_SECURE=false
DATABASE_URL=sqlite:///./campusflow.db
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
POSTGRES_PASSWORD=campusflow-local-only-change-for-shared-deployments

# Optional OpenAI-compatible provider. The deterministic demo needs no API key.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
